<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="646.0" prefWidth="890.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SceneController">

    <ComboBox fx:id="labComboBox" StackPane.alignment="TOP_CENTER" />

    <!-- Lab 1 layer -->
    <VBox fx:id="lab1Layer" alignment="CENTER" spacing="10" visible="false">
        <Label text="Выбор типа передвижения:" />

        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <RadioButton fx:id="walkStrategyRB" text="Пеший ход" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
            <RadioButton fx:id="runStrategyRB" text="Бег" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
            <RadioButton fx:id="horseStrategyRB" text="Лошадь" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <RadioButton fx:id="flyStrategyRB" text="Полёт" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <RadioButton fx:id="swimStrategyRB" text="Плавание" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
        </GridPane>

        <Label text="Откуда:"/>
        <TextField fx:id="lab1FromTF" promptText="Ввод места отправления"/>
        <Label text="Куда:"/>
        <TextField fx:id="lab1ToTF" promptText="Ввод места назначения"/>
        <Label text="Результат:"/>
        <TextArea fx:id="lab1OutputTA" editable="false" prefRowCount="4" wrapText="true"/>
        <Button fx:id="lab1StartBut" onAction="#lab1StartExpedition" text="Отправиться в путь"/>

        <StackPane.margin>
            <Insets top="50.0"/>
        </StackPane.margin>
    </VBox>

    <!-- Lab 2 layer -->
    <VBox fx:id="lab2Layer" alignment="CENTER" spacing="15" visible="false">
        <Label text="Класс:"/>
        <TextField fx:id="lab2ClassTF" editable="false"/>

        <Label text="Метод для выполнения:"/>
        <HBox spacing="15">
            <ComboBox fx:id="lab2MethodsCB" />
            <CheckBox fx:id="lab2AllMethodsCB" text="Выполнить все методы"/>
        </HBox>
        <CheckBox fx:id="lab2HasPropertyCB" text="Имеет аннотацию Repeat" disable="true" />

        <Label fx:id="lab2ModifierLabel" text="Модификатор доступа:"/>

        <Button contentDisplay="CENTER" onAction="#lab2ExecuteMethodButton" text="Выполнить выбранный метод"/>
        <Label text="Вывод:"/>
        <TextArea fx:id="lab2OutputTA" editable="false" prefRowCount="12" wrapText="true"/>

        <StackPane.margin>
            <Insets top="50.0"/>
        </StackPane.margin>
    </VBox>

    <!-- Lab 3 layer -->
    <VBox fx:id="lab3Layer" alignment="CENTER" spacing="10" visible="false">
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="lab3ChangeDictFileBut" alignment="CENTER" contentDisplay="CENTER" onAction="#lab3ChangeDictionaryFile" text="Выбрать файл словаря" textAlignment="CENTER"/>
            <Button fx:id="lab3ChangeUserTextFileBut" alignment="CENTER" contentDisplay="CENTER" onAction="#lab3ChangeTextFile" text="Выбрать файл текста" textAlignment="CENTER"/>
        </HBox>
        <GridPane alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <Label text="Словарь:" GridPane.columnIndex="0"/>
            <Label text="Текст:" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox alignment="CENTER" spacing="10">
            <TextArea fx:id="lab3DictionaryTA" prefRowCount="50" wrapText="true"/>
            <TextArea fx:id="lab3UserTextTA" prefRowCount="50" wrapText="true"/>
        </HBox>

        <Button contentDisplay="CENTER" onAction="#lab3TranslateText" text="Перевести"/>
        <TextArea fx:id="lab3TranslateTA" editable="false" prefRowCount="50" wrapText="true"/>

        <StackPane.margin>
            <Insets top="50.0" />
        </StackPane.margin>
    </VBox>

    <!-- Lab 4 layer -->
    <VBox fx:id="lab4Layer" spacing="10" visible="false">

        <Label text="Доступные методы:"/>
        <ComboBox fx:id="lab4MethodsCB" />

        <Label fx:id="lab4ArgumentsLabel" text="Аргументы выбранного метода:"/>
        <Label text="Ввод аргументов (через пробел):"/>
        <TextField fx:id="lab4ArgumentsTF"/>

        <Button contentDisplay="CENTER" onAction="#lab4ExecuteMethodButton" text="Выполнить выбранный метод"/>
        <Label text="Вывод:"/>
        <TextArea fx:id="lab4OutputTA" editable="false" prefRowCount="12" wrapText="true"/>

      <StackPane.margin>
         <Insets top="50.0" />
      </StackPane.margin>
    </VBox>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>

</StackPane>
